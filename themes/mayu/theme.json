{
  "name": "码语 Mayu",
  "version": "1.0.0",
  "requires_core": "1.0.0",
  "author": "YeCha",
  "description": "码语 Mayu —— 仿 CodingLife 开发者社区：科技青蓝强调、浅灰底、Helvetica 无衬线、清爽技术风。",
  "home": "landing",
  "settings": [
    {"key": "width", "type": "number", "label": "版心宽度", "def": "1180", "min": 960, "max": 1440},
