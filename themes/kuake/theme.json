{
  "name": "夸克 Kuake",
  "version": "1.0.0",
  "requires_core": "1.0.0",
  "author": "YeCha",
  "description": "夸克 Kuake —— 仿 quarkblog 的纸白极简博客：纯白底、红色链接强调、系统无衬线字体、清爽单栏文章列表。",
  "home": "landing",
