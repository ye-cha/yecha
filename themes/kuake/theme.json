      "max": 1440
    },
    {
      "key": "accent",
      "type": "color",
      "label": "强调色",
      "def": "#c81e1e"
    },
    {
      "key": "per_page",
      "type": "number",
      "label": "每页条数",
      "def": "10",
      "min": 3,
      "max": 50
