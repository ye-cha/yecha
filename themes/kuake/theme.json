    {
      "key": "latest_n",
      "type": "number",
      "label": "首页最新条数",
      "def": "6",
      "min": 3,
      "max": 12
    },
    {
      "key": "show_sidebar",
      "type": "checkbox",
      "label": "显示侧栏",
      "def": "1"
    }
  ]
