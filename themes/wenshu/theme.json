{
  "name": "文枢 Wenshu",
  "version": "1.0.0",
  "requires_core": "1.0.0",
  "author": "YeCha",
  "description": "文枢 Wenshu —— 仿 Mkdocs Material 文档站：靛蓝(Indigo)强调色、洁净浅色底、系统无衬线字体、清晰文档感排版。",
  "home": "landing",
