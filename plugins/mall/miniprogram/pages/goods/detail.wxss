.sw, .swimg { width: 100%; height: 600rpx; background: #eee; display: block; }
.info { margin-top: 0; }
.gt { font-size: 32rpx; font-weight: 700; line-height: 1.4; }
.sub { color: #888; font-size: 26rpx; margin: 8rpx 0; }
.sales { color: #999; font-size: 24rpx; }
.sku-t { font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx; }
.sku-list { display: flex; flex-wrap: wrap; }
.sk { padding: 14rpx 22rpx; margin: 0 16rpx 16rpx 0; background: #f4f4f4; font-size: 26rpx; color: #555; }
.sk.on { background: #a21400; color: #fff; }
.num-row { margin-top: 16rpx; }
.stepper { display: flex; align-items: center; }
.step { width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; background: #f4f4f4; font-size: 36rpx; }
.num { width: 90rpx; text-align: center; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; height: 100rpx; display: flex; background: #fff; border-top: 1rpx solid #eee; }
.bar-btn { flex: 1; text-align: center; line-height: 100rpx; color: #fff; font-size: 30rpx; }
.bar-btn.cart { background: #e2902a; }
.bar-btn.buy { background: #a21400; }
.gd { padding-bottom: 120rpx; }
