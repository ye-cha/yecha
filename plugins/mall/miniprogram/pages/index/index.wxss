.banner { background: #a21400; color: #fff; padding: 28rpx 24rpx; font-size: 32rpx; font-weight: 700; }
.cats { display: flex; flex-wrap: wrap; background: #fff; padding: 16rpx 8rpx; }
.cat { padding: 12rpx 24rpx; margin: 8rpx; background: #f4f4f4; color: #555; font-size: 26rpx; }
.grid { display: flex; flex-wrap: wrap; padding: 8rpx; }
.g { width: calc(50% - 16rpx); margin: 8rpx; background: #fff; padding-bottom: 16rpx; }
.gimg { width: 100%; height: 320rpx; background: #eee; }
.gt { padding: 12rpx 16rpx 4rpx; font-size: 28rpx; line-height: 1.4; height: 76rpx; overflow: hidden; }
.g .price { padding: 0 16rpx; }
.news { background: #fff; margin: 16rpx; }
.n { display: flex; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.nimg { width: 160rpx; height: 120rpx; background: #eee; margin-right: 20rpx; }
.nbody { flex: 1; }
.nt { font-size: 28rpx; line-height: 1.4; }
.nd { color: #999; font-size: 24rpx; margin-top: 8rpx; line-height: 1.4; height: 64rpx; overflow: hidden; }
