# ===== YeCha site repo .gitignore (2026-09-18, DSH batch scheme+poly) =====
# *** secrets: library credentials / auth files — never commit ***
/config.inc.php
/config.inc.php.bak*
/config.local.php
/var/gupiao/dsa.htpasswd
*.htpasswd
*.pem
*.key

# runtime state / caches / logs / spools (regenerated, volatile)
/var/
/logs/
/tmp/
/runtime/
*.log
*.cache

# uploads & imported media
/uploads/
/media/

# vendored / downloaded big data & release artifacts
/data/
/download/
/updates/

# generated sitemaps (tens of MB, rebuilt by cron)
/sitemap*.xml
/sitemap_index.xml

# local backups of code (kept on disk, out of history)
*.bak
*.bak-*
*.bak_*
*.bak.*
*.before-*
*.pre-*
*.pre-c1-*
*.orig
*.rej
*.spgtmp.*

# editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~
